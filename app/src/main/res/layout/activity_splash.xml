<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pine_primary">

    <!-- Ikon Logo SakuKu -->
    <ImageView
        android:id="@+id/imgLogoSplash"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_spinner"
        android:backgroundTint="@color/pine_deep"
        android:padding="20dp"
        android:src="@drawable/baseline_receipt_long_24"
        app:layout_constraintBottom_toTopOf="@+id/txtSplashTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="@color/lime_accent" />

    <!-- Judul Aplikasi -->
    <TextView
        android:id="@+id/txtSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/app_name"
        android:textColor="@color/surface_white"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/txtSplashSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgLogoSplash" />

    <!-- Tagline Subtitle -->
    <TextView
        android:id="@+id/txtSplashSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Pencatat Keuangan Sederhana"
        android:textColor="@color/pine_subtle"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtSplashTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
