<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <!-- Ikon Kategori -->
            <ImageView
                android:id="@+id/imgKategori"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_spinner"
                android:backgroundTint="@color/pine_subtle"
                android:padding="10dp"
                android:src="@drawable/baseline_receipt_long_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/pine_primary" />

            <!-- Judul Catatan Transaksi -->
            <TextView
                android:id="@+id/txtJudul"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Warung Bu Sari"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/txtNominal"
                app:layout_constraintStart_toEndOf="@+id/imgKategori"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Sub detail (Kategori · Kantong · Tanggal) -->
            <TextView
                android:id="@+id/txtSubDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Makan &amp; Minum · Tunai · 12 Nov 2026"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/txtNominal"
                app:layout_constraintStart_toEndOf="@+id/imgKategori"
                app:layout_constraintTop_toBottomOf="@+id/txtJudul" />

            <!-- Nominal (Warna dinamis merah/hijau) -->
            <TextView
                android:id="@+id/txtNominal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-Rp 32.000"
                android:textColor="@color/expense_rose"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
